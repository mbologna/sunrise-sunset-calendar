{
    "name": "michele/sunrise-sunset-calendar",
    "description": "High-precision iCalendar feed generator for sunrise, sunset, and twilight times using NREL SPA algorithms",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "abbadon1334/sun-position-spa-php": "^2.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.3.1",
        "phpunit/phpunit": "^9.6 || ^10.0 || ^13.0",
        "squizlabs/php_codesniffer": "^4.0.4"
    },
    "autoload": {
        "psr-4": {
            "SunCalendar\\": "src/"
        },
        "files": [
            "src/functions.php",
            "src/astronomy.php",
            "src/helpers.php",
            "src/calendar-generator.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "test": "./vendor/bin/phpunit",
        "test:unit": "./vendor/bin/phpunit --testsuite Unit",
        "test:coverage": "./vendor/bin/phpunit --coverage-html coverage/",
        "analyse": "./vendor/bin/phpstan analyse",
        "lint": "./vendor/bin/phpcs",
        "lint:fix": "./vendor/bin/phpcbf",
        "check:all": [
            "@test",
            "@analyse",
            "@lint"
        ]
    }
}
